# Primary database (docker compose service: db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/support_tickets?schema=public"

# Test database (docker compose service: db_test) — wiped freely by integration tests
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/support_tickets_test?schema=public"

# Secret used to sign JWTs. Use a long random value outside local development.
JWT_SECRET="dev-only-change-me-to-a-long-random-string"

# Business hours used by the SLA engine
BUSINESS_TIMEZONE="Asia/Kolkata"
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18

# Invite code required to sign up as an AGENT
AGENT_SIGNUP_CODE="let-me-in"

# HTTP port for the GraphQL server
PORT=4000
