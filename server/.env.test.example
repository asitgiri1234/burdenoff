# Integration tests run against the `db_test` compose service on port 5433.
# Copy to .env.test — it is gitignored so local ports can differ.
NODE_ENV=test

# Prisma reads DATABASE_URL; both point at the test database so the app under
# test and the migration step agree on which database they are using.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/support_tickets_test?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/support_tickets_test?schema=public"

JWT_SECRET="test-secret-value-that-is-long-enough"
BUSINESS_TIMEZONE="Asia/Kolkata"
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18
AGENT_SIGNUP_CODE="test-agent-code"
PORT=4001
