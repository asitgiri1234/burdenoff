{
  "name": "support-ticket-tracker-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/server.ts",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "gendb": "prisma generate && prisma migrate dev && prisma db seed",
    "migrate": "prisma migrate dev",
    "seed": "prisma db seed",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "graphql": "^16.10.0",
    "luxon": "^3.7.2",
    "graphql-yoga": "^5.10.11",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/typescript": "^4.1.2",
    "@graphql-codegen/typescript-resolvers": "^4.4.1",
    "@types/bun": "^1.1.17",
    "@types/luxon": "^3.7.5",
    "eslint": "^9.18.0",
    "prisma": "^6.2.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
